<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Le runtime durci interdit les Apple Events par defaut. Sans cette
         cle, la question « Finder, que viens-tu de selectionner ? » est
         refusee AVANT meme que macOS ne demande l'autorisation : aucune
         alerte, aucune trace, la selection revient simplement vide. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
